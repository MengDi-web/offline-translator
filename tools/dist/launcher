#!/bin/bash
# miaomiao翻译器 一键启动器：准备环境 → 启动服务 → 打开网页 → 主进程交给划词助手
# 划词助手以 --app-main 常驻：提供 Dock 图标/菜单栏，点击图标前置浏览器，退出时清理服务
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RES="$APP_DIR/Resources"
NODE="$APP_DIR/MacOS/node"
HELPER="$APP_DIR/MacOS/划词助手"
export MIAOMIAO_ROOT="$RES"

# 内置可搬移 Python（随应用走，无需系统安装）
BUNDLED_PY="$RES/python/bin/python3.12"
PY="$BUNDLED_PY"
if [ ! -x "$PY" ]; then
  # 回退系统 Python 3.12
  for c in "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12" \
           "/usr/local/bin/python3.12" "/opt/homebrew/bin/python3.12" python3.12; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; exit(0 if sys.version_info[:2]==(3,12) else 1)' 2>/dev/null; then
      PY="$c"; break
    fi
  done
fi
export NMT_PY="${PY:-/usr/bin/python3}"
# 神经库随应用走（PYTHONPATH 方式，无需 pip 安装）
export PYTHONPATH="$RES/python-libs"
export PYTHONHOME=""

# 服务未运行时启动
if ! curl -s -m 2 "http://127.0.0.1:6688/api/stats" >/dev/null 2>&1; then
  "$NODE" "$RES/server.js" --port 6688 > /tmp/miaomiao-server.log 2>&1 &
fi
sleep 2

# 清理可能残留的旧助手，再打开网页
pkill -f "$HELPER" 2>/dev/null
open "http://127.0.0.1:6688"

# 主进程交给划词助手（--app-main 常驻，处理菜单栏/退出/点击前置）
exec "$HELPER" --app-main
